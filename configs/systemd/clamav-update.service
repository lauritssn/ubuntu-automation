[Unit]
Description=ClamAV Signature Update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/clamav-update.sh
# Update Maldet signature links after ClamAV signatures are updated (optional - don't fail if missing)
ExecStartPost=-/bin/bash -c 'if [ -x "/usr/local/bin/update-maldet-clamav-links.sh" ]; then /usr/local/bin/update-maldet-clamav-links.sh update; fi'
StandardOutput=journal
StandardError=journal

# Timeout after 30 minutes to prevent hanging
TimeoutStartSec=1800

# Only run if network is available
ConditionPathExists=/usr/bin/freshclam

[Install]
WantedBy=multi-user.target 