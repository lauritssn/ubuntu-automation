[Unit]
Description=ClamAV Signature Update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/clamav-update.sh
StandardOutput=journal
StandardError=journal

# Timeout after 30 minutes to prevent hanging
TimeoutStartSec=1800

# Only run if network is available
ConditionPathExists=/usr/bin/freshclam

[Install]
WantedBy=multi-user.target 