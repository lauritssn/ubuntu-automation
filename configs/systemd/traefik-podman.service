[Unit]
Description=Traefik Reverse Proxy via Docker Compose
After=network-online.target
Wants=network-online.target
RequiresMountsFor=%t/containers

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/traefik
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30

ExecStartPre=/usr/bin/podman-compose pull
ExecStart=/usr/bin/podman-compose up -d
ExecStartPost=/bin/sleep 10
ExecStartPost=/usr/bin/curl -f http://localhost:8080/ping || exit 1
ExecStop=/usr/bin/podman-compose down
ExecReload=/usr/bin/podman-compose restart

[Install]
WantedBy=multi-user.target