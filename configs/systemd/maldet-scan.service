[Unit]
Description=Maldet Security Scan
Documentation=man:maldet(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Send service start notification
ExecStartPre=/bin/bash -c 'logger -p user.info -t maldet-scan "Maldet scan service starting on $(hostname)"'
ExecStart=/usr/local/bin/maldet-scan.sh
# Send service completion notification
ExecStartPost=/bin/bash -c 'logger -p user.info -t maldet-scan "Maldet scan service completed on $(hostname)"'
StandardOutput=journal
StandardError=journal
IOSchedulingClass=3
Nice=19
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/maldet /tmp /usr/local/maldetect
TimeoutSec=21600

[Install]
WantedBy=multi-user.target 