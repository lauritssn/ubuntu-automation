# Traefik Configuration
# Copy this file to .env and update the values

# Basic Configuration
TRAEFIK_LOG_LEVEL=DEBUG
TRAEFIK_API_DASHBOARD=true
TRAEFIK_API_INSECURE=true

# Let's Encrypt Configuration
LETSENCRYPT_EMAIL=lsn@werktoej.dk

# Domain Configuration
TRAEFIK_DASHBOARD_DOMAIN=traefik.localhost
TRAEFIK_METRICS_DOMAIN=metrics.localhost

# Dashboard Authentication (generate with: htpasswd -nb username password)
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$10$$your-hashed-password-here

# CORS Configuration
ALLOWED_ORIGINS=https://werktoej.dk,https://www.werktoej.dk

# Network Configuration
TRAEFIK_NETWORK=traefik

# Development Only
# Uncomment for development environment
# TRAEFIK_API_INSECURE=true
# TRAEFIK_LOG_LEVEL=DEBUG

# Production Security
# Uncomment and configure for production
# TRAEFIK_PILOT_TOKEN=your-pilot-token-here
# TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

# Optional: Custom Certificate Paths
# TRAEFIK_CERT_PATH=/certs
# TRAEFIK_KEY_PATH=/certs

# Optional: Database Configuration for Enterprise features
# TRAEFIK_CLUSTER_STORE=consul
# TRAEFIK_CLUSTER_PREFIX=traefik

# Monitoring Configuration
PROMETHEUS_ENABLED=true
ACCESS_LOG_ENABLED=true

# Rate Limiting Defaults
DEFAULT_RATE_LIMIT_BURST=100
DEFAULT_RATE_LIMIT_AVERAGE=50

# Security Headers
SECURITY_FRAME_DENY=true
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_BROWSER_XSS_FILTER=true
SECURITY_FORCE_STS_HEADER=true
SECURITY_STS_SECONDS=31536000
