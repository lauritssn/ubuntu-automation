[Unit]
Description=Traefik Test Container (Socket Activation)
After=network-online.target traefik-test.socket
Wants=network-online.target
Requires=traefik-test.socket
Documentation=https://doc.traefik.io/traefik/

[Container]
AutoUpdate=registry
ContainerName=traefik-test
Image=docker.io/traefik:v3.5.0
SecurityLabelDisable=true

# Volumes
Volume=%h/NoBackup.nosync/Projects/ubuntu-automation/traefik/traefik-test.yml:/etc/traefik/traefik.yml:ro,Z
Volume=%h/NoBackup.nosync/Projects/ubuntu-automation/traefik/dynamic:/etc/traefik/dynamic:ro,Z
Volume=%h/NoBackup.nosync/Projects/ubuntu-automation/traefik/data:/data:Z
Volume=%h/NoBackup.nosync/Projects/ubuntu-automation/traefik/logs:/var/log/traefik:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro

# Network
Network=traefik

# Health check
HealthCmd=traefik healthcheck --ping
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

# Labels
Label=traefik.enable=true
Label=traefik.http.routers.dashboard.rule=Host(`traefik.localhost`)
Label=traefik.http.routers.dashboard.service=api@internal
Label=traefik.http.routers.dashboard.entrypoints=web
Label=traefik.http.routers.dashboard.middlewares=test-headers

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target