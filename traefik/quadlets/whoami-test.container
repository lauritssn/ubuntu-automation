[Unit]
Description=Whoami Test Service
After=traefik-test.service
Wants=traefik-test.service
Documentation=https://github.com/traefik/whoami

[Container]
AutoUpdate=registry
ContainerName=whoami-test
Image=docker.io/traefik/whoami:latest
SecurityLabelDisable=true

# Network
Network=traefik

# Health check
# HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:80/health
# HealthInterval=30s
# HealthTimeout=10s
# HealthRetries=3
# HealthStartPeriod=10s

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target