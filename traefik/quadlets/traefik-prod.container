[Unit]
Description=Traefik Production Container (Socket Activation)
After=network-online.target http-prod.socket https-prod.socket traefik-prod.socket
Wants=network-online.target
Requires=http-prod.socket https-prod.socket traefik-prod.socket
Documentation=https://doc.traefik.io/traefik/

[Container]
# Remove AutoUpdate for production - handle updates through CI/CD
# AutoUpdate=registry
ContainerName=traefik-prod

# Good: Using pinned version instead of :latest
Image=docker.io/traefik:v3.5.0

# Remove this unless you have a specific AppArmor issue
# SecurityLabelDisable=true
User=podman:podman

LogDriver=journald
LogOpt=tag=traefik-prod

# Volumes
Volume=/srv/apps/deploy/traefik/traefik-prod.yml:/etc/traefik/traefik.yml:ro,Z
Volume=/srv/apps/deploy/traefik/dynamic/prod:/etc/traefik/sites/config:ro,Z
Volume=/srv/apps/deploy/traefik/dynamic/shared:/etc/traefik/sites/shared:ro,Z
Volume=/srv/apps/deploy/traefik/data:/data:Z
Volume=/srv/apps/deploy/traefik/logs:/var/log/traefik:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro

# Network
Network=traefik

# Environment variables
Environment=LETSENCRYPT_EMAIL=${LETSENCRYPT_EMAIL}
Environment=APP_DOMAIN=${APP_DOMAIN}
Environment=TRAEFIK_DASHBOARD_DOMAIN=${TRAEFIK_DASHBOARD_DOMAIN:-traefik.${APP_DOMAIN}}
Environment=WHOAMI_DOMAIN=${WHOAMI_DOMAIN:-whoami.${APP_DOMAIN}}

# Security hardening
NoNewPrivileges=true
ReadOnlyTmpfs=true

# Drop all capabilities, add only what's needed
DropCapability=ALL

# Traefik needs these for binding to privileged ports and network operations
AddCapability=CAP_NET_BIND_SERVICE

# Resource limits
Memory=512m
MemoryReservation=256m

# Add CPU limits
CpuQuota=100%
PidsLimit=1024

# Health check
HealthCmd=traefik healthcheck --ping --entryPoint=internal
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

# Additional security options
Tmpfs=/tmp:rw,noexec,nosuid,size=100m

# Prevent container from gaining new privileges
SecurityOpt=no-new-privileges:true

# Use a more restrictive seccomp profile if available
SecurityOpt=seccomp=unconfined

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target