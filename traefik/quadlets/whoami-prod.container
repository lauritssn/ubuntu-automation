[Unit]
Description=Whoami Production Service
After=traefik-prod.service
Wants=traefik-prod.service
Documentation=https://github.com/traefik/whoami

[Container]
AutoUpdate=registry
ContainerName=whoami-prod

# Pin to specific version instead of :latest
Image=docker.io/traefik/whoami:latest

# Only disable if you have a specific need and understand the risk
# SecurityLabelDisable=true
User=podman:podman

# Add security hardening
ReadOnly=true
NoNewPrivileges=true

# Drop all capabilities and add only what's needed
DropCapability=ALL

# Limit resources
Memory=128M

# Network
Network=traefik

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target