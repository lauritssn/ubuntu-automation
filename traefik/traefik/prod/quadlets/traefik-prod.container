[Unit]
Description=Traefik Production Container (Socket Activation)
After=network-online.target http-prod.socket https-prod.socket traefik-prod.socket
Wants=network-online.target
Requires=http-prod.socket https-prod.socket traefik-prod.socket
Documentation=https://doc.traefik.io/traefik/

[Container]
# Remove AutoUpdate for production - handle updates through CI/CD
# AutoUpdate=registry
ContainerName=traefik-prod

# SECURITY: Using pinned version instead of :latest
Image=docker.io/traefik:v3.5.0

# SECURITY: Keep AppArmor enabled for additional protection
# SecurityLabelDisable=true  # Only uncomment if AppArmor conflicts arise
User=podman:podman

LogDriver=journald

# Cloudflare DNS challenge environment variables
EnvironmentFile=/srv/apps/deploy/traefik/cloudflare.env

# Volumes
Volume=/srv/apps/deploy/traefik/traefik.yml:/etc/traefik/traefik.yml:ro,Z
Volume=/srv/apps/deploy/traefik/dynamic/prod:/etc/traefik/sites/config:ro,Z
Volume=/srv/apps/deploy/traefik/data:/data:Z
Volume=/srv/apps/deploy/traefik/logs:/var/log/traefik:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro

# Network
Network=traefik

# Security hardening
NoNewPrivileges=true
ReadOnlyTmpfs=true

# Drop all capabilities, add only what's needed
DropCapability=ALL

# Traefik needs these for binding to privileged ports and network operations
AddCapability=CAP_NET_BIND_SERVICE

# SECURITY: CPU and process limits
PidsLimit=1024

# SECURITY: Enhanced health check
HealthCmd=traefik healthcheck --ping --entryPoint=internal
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

# SECURITY: Additional hardening options
Tmpfs=/tmp:rw,noexec,nosuid,size=100m

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target