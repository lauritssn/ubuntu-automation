[Unit]
Description=Traefik Production Stack (Docker Compose via Quadlet)
After=traefik.socket
Requires=traefik.socket

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/srv/apps/deploy/WTools/traefik
EnvironmentFile=/srv/apps/deploy/WTools/traefik/.env
ExecStartPre=/usr/bin/podman network exists traefik || /usr/bin/podman network create traefik --external
ExecStart=/usr/bin/podman-compose -f /srv/apps/deploy/WTools/traefik/docker-compose.prod.yml up -d
ExecStop=/usr/bin/podman-compose -f /srv/apps/deploy/WTools/traefik/docker-compose.prod.yml down
ExecReload=/usr/bin/podman-compose -f /srv/apps/deploy/WTools/traefik/docker-compose.prod.yml restart
TimeoutStartSec=120
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target 