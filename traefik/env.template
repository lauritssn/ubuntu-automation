# Traefik Configuration Template
# Copy this file to .env and update the values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Domain Configuration
APP_DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com

# =============================================================================
# OPTIONAL SETTINGS (have sensible defaults)
# =============================================================================

# Development Ports (only used in dev environment)
TRAEFIK_WEB_PORT=80
TRAEFIK_WEBSECURE_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Network Name
TRAEFIK_NETWORK=traefik

# Dashboard Domain (optional - defaults to traefik.${APP_DOMAIN})
# TRAEFIK_DASHBOARD_DOMAIN=traefik.yourdomain.com

# Whoami Domain (optional - defaults to whoami.${APP_DOMAIN})
# WHOAMI_DOMAIN=whoami.yourdomain.com

# =============================================================================
# PRODUCTION SECURITY (IMPORTANT!)
# =============================================================================

# Dashboard Authentication (REQUIRED if dashboard is enabled)
# Generate with: htpasswd -nbB admin yourpassword
# Example: docker run --rm httpd:2.4-alpine htpasswd -nbB admin yourpassword
# WARNING: Dashboard is disabled by default in production for security
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$10$$2b2cu8Sw4kADVOskOnCpYOBz.qtgHPVBpALBjNpjfw/OaEbWtl4nu

# CORS Origins (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Settings
# SECURITY_RATE_LIMIT_AVERAGE=100
# SECURITY_RATE_LIMIT_BURST=200

# =============================================================================
# QUICK SETUP EXAMPLES
# =============================================================================

# Development Setup:
# 1. Copy this to .env
# 2. Set APP_DOMAIN=localhost (or skip - defaults work)
# 3. Set TRAEFIK_LOG_LEVEL=DEBUG
# 4. Run: ./scripts/deploy-dev.sh

# Production Setup:
# 1. Copy this to .env
# 2. Set APP_DOMAIN=yourdomain.com
# 3. Set LETSENCRYPT_EMAIL=admin@yourdomain.com
# 4. Generate secure TRAEFIK_DASHBOARD_USERS hash if enabling dashboard
# 5. Run: ./scripts/deploy-prod.sh

# Security Notes:
# - Dashboard is disabled by default in production
# - WAF (Coraza) protection is enabled
# - Modern TLS configuration enforces TLS 1.2+
# - Rate limiting and security headers are applied
# - All traffic is automatically redirected to HTTPS