# Traefik Configuration
# Copy this file to .env and update the values

# Environment Configuration
ENVIRONMENT=production  # Set to 'development' for local dev

# Service Domains (Production)
APP_DOMAIN=your-app.domain.com
VAULTWARDEN_URL=vault.domain.com  
MONITOR_URL=monitor.domain.com

# Traefik Configuration
TRAEFIK_VERSION=v3.5.0
TRAEFIK_LOG_LEVEL=INFO  # Use DEBUG for development
TRAEFIK_API_DASHBOARD=true
TRAEFIK_API_INSECURE=false  # Set to true for development

# Port Configuration (Development only - Production uses socket activation)
TRAEFIK_WEB_PORT=80
TRAEFIK_WEBSECURE_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Let's Encrypt Configuration (Production only)
LETSENCRYPT_EMAIL=your-email@domain.com

# Domain Configuration  
TRAEFIK_DASHBOARD_DOMAIN=traefik.yourdomain.com  # Use traefik.localhost for dev
TRAEFIK_METRICS_DOMAIN=metrics.yourdomain.com

# Hello World Example Configuration
HELLO_WORLD_DOMAIN=hello.localhost  # Development
# HELLO_WORLD_DOMAIN=hello.yourdomain.com  # Production
WHOAMI_VERSION=latest

# Dashboard Authentication (generate with: htpasswd -nb admin password)
# For development, you can leave this empty as dashboard is insecure
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$10$$...

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Network Configuration
TRAEFIK_NETWORK=traefik

# Development Settings
COMPOSE_PROJECT_NAME=traefik

# Podman Runtime (replace 1001 with your user ID: $(id -u))
XDG_RUNTIME_DIR=/run/user/1001

# Monitoring Configuration
PROMETHEUS_ENABLED=true
ACCESS_LOG_ENABLED=true

# Rate Limiting Defaults
DEFAULT_RATE_LIMIT_BURST=100
DEFAULT_RATE_LIMIT_AVERAGE=50

# Security Headers (Production)
SECURITY_FRAME_DENY=true
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_BROWSER_XSS_FILTER=true
SECURITY_FORCE_STS_HEADER=true
SECURITY_STS_SECONDS=31536000

# Trusted IPs for Forwarded Headers (Production)
TRUSTED_IPS=172.18.0.0/16,172.19.0.0/16,172.20.0.0/16,127.0.0.1/32,::1/128 

# Quick Development Setup Guide:
# 1. Copy this to .env
# 2. Set ENVIRONMENT=development
# 3. Set TRAEFIK_LOG_LEVEL=DEBUG
# 4. Set TRAEFIK_API_INSECURE=true
# 5. Use .localhost domains
# 6. No LETSENCRYPT_EMAIL needed
#
# Quick Production Setup Guide:
# 1. Copy this to .env
# 2. Set ENVIRONMENT=production
# 3. Update APP_DOMAIN to your real domain
# 4. Set LETSENCRYPT_EMAIL to your email
# 5. Generate TRAEFIK_DASHBOARD_USERS with htpasswd
# 6. Update XDG_RUNTIME_DIR with correct user ID 