# Traefik Configuration
# Copy this file to .env and update the values

# Service Domains (Production)
APP_DOMAIN=your-app.domain.com
VAULTWARDEN_URL=vault.domain.com  
MONITOR_URL=monitor.domain.com

# Basic Configuration
TRAEFIK_VERSION=v3.5.0
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_API_DASHBOARD=true
TRAEFIK_API_INSECURE=false

# Port Configuration (Development only - Production uses socket activation)
TRAEFIK_WEB_PORT=80
TRAEFIK_WEBSECURE_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Let's Encrypt Configuration
LETSENCRYPT_EMAIL=your-email@domain.com

# Domain Configuration  
TRAEFIK_DASHBOARD_DOMAIN=traefik.yourdomain.com
TRAEFIK_METRICS_DOMAIN=metrics.yourdomain.com

# Hello World Example Configuration
HELLO_WORLD_DOMAIN=hello.localhost
WHOAMI_VERSION=latest

# Dashboard Authentication (generate with: htpasswd -nb admin password)
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$10$$...

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Network Configuration
TRAEFIK_NETWORK=traefik

# Development Settings
COMPOSE_PROJECT_NAME=traefik

# Podman Runtime (replace 1001 with your user ID: $(id -u))
XDG_RUNTIME_DIR=/run/user/1001

# Monitoring Configuration
PROMETHEUS_ENABLED=true
ACCESS_LOG_ENABLED=true

# Rate Limiting Defaults
DEFAULT_RATE_LIMIT_BURST=100
DEFAULT_RATE_LIMIT_AVERAGE=50

# Security Headers
SECURITY_FRAME_DENY=true
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_BROWSER_XSS_FILTER=true
SECURITY_FORCE_STS_HEADER=true
SECURITY_STS_SECONDS=31536000

# Trusted IPs for Forwarded Headers (Production)
TRUSTED_IPS=172.18.0.0/16,172.19.0.0/16,172.20.0.0/16,127.0.0.1/32,::1/128 