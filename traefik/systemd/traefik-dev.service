[Unit]
Description=Traefik Development Stack (Direct Port Mapping)
After=network-online.target
Wants=network-online.target
Documentation=https://traefik.io/

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/srv/apps/deploy/WTools/traefik
EnvironmentFile=/srv/apps/deploy/WTools/traefik/.env
# Ensure network exists before starting
ExecStartPre=/usr/bin/podman network exists traefik || /usr/bin/podman network create traefik
# Create logs directory
ExecStartPre=/bin/mkdir -p /srv/apps/deploy/WTools/traefik/logs
ExecStartPre=/bin/chown -R podman:podman /srv/apps/deploy/WTools/traefik/logs
# Start the compose stack
ExecStart=/usr/bin/podman-compose -f docker-compose.dev.yml up -d
# Stop the compose stack
ExecStop=/usr/bin/podman-compose -f docker-compose.dev.yml down
# Reload the compose stack
ExecReload=/usr/bin/podman-compose -f docker-compose.dev.yml restart
# Extended timeouts for container operations
TimeoutStartSec=300
TimeoutStopSec=60
# Restart policy
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target 