[Unit]
Description=Traefik socket activation for production
Documentation=https://traefik.io/

[Socket]
# HTTP port
ListenStream=0.0.0.0:80
# HTTPS port
ListenStream=0.0.0.0:443
# Dashboard/API port
ListenStream=0.0.0.0:8080
# Allow binding to privileged ports even if they're busy
FreeBind=true
# Preserve client IP addresses
NoDelay=true

[Install]
WantedBy=sockets.target